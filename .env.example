# MezoCommerce — copy to .env.local (web) and set the same values on the worker (Render).
# Never commit real values.

# ── Chain (web + worker) ───────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_MEZO_RPC_URL=https://rpc.test.mezo.org
# MUSD on Mezo Testnet (default if unset)
NEXT_PUBLIC_MUSD_ADDRESS=0x118917a40FAF1CD7a13dB0Ef56C86De7973Ac503
# MerchantPaymentProcessor (contracts/deployments/31611.json). Unset = the built-in testnet deployment below
NEXT_PUBLIC_PROCESSOR_ADDRESS=0x94D35689d95b4C7ec9c8bD296ff606027e154df8
# Block the processor was deployed at; the indexer starts here
NEXT_PUBLIC_DEPLOY_BLOCK=16752201
# Public origin of the web app (checkout URLs, SIWE domain pinning, webhook URLs shown to merchants)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: adds WalletConnect to the Mezo Passport connect modal (cloud.reown.com project id)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ── Database (API + worker) ────────────────────────────────────────────────────────────────────────────
# Postgres URL (Neon/Supabase pooler OK). Unset → embedded PGlite at .data/pglite (local dev only).
DATABASE_URL=
# Optional schema when the database is shared with other apps (e.g. mezocommerce). Needs a session pooler URL.
DATABASE_SCHEMA=
# Optional: pool size for postgres.js (default 5)
# DB_POOL_MAX=5
# Optional: PGlite directory ("memory" for in-memory)
# PGLITE_DATA_DIR=

# ── Secrets (API; ENCRYPTION_KEY also on the worker) ───────────────────────────────────────────────────
# ≥ 32 chars. Signs the session cookie.   openssl rand -hex 32
SESSION_SECRET=
# ≥ 32 chars. API keys are stored as sha256(API_KEY_PEPPER ‖ key). Changing it invalidates every key.
API_KEY_PEPPER=
# 32 bytes as 64 hex chars. AES-256-GCM for Shopify Admin tokens / API secrets.   openssl rand -hex 32
ENCRYPTION_KEY=
# Platform intent signer (EIP-712). API ONLY — holds no funds, needs no gas. Its address is what merchants
# authorize on-chain. Required in production; in dev a key is generated into .data/dev-signer.key.
INTENT_SIGNER_PRIVATE_KEY=
# Worker only (instead of the key): the platform signer ADDRESS, used to re-check isSigner during reconciliation
PLATFORM_SIGNER_ADDRESS=
# Bearer secret for POST /api/indexer/sync (cron fallback that runs one worker pass)
INDEXER_SECRET=
# Optional, production: extra hosts allowed in sign-in messages (comma-separated, e.g. a Vercel preview host)
# SIWE_EXTRA_DOMAINS=

# ── Worker tuning ──────────────────────────────────────────────────────────────────────────────────────
CONFIRMATIONS=2
WORKER_INTERVAL_MS=5000
RECONCILE_EVERY=20

# ── Reference storefront (/demo-store) ─────────────────────────────────────────────────────────────────
# A real API key (mc_test_sk_…) of the demo merchant; unset → the demo store answers 503.
DEMO_STORE_API_KEY=
# Secret (whsec_…) of the demo merchant's webhook endpoint pointing at ${APP_URL}/api/demo-store/webhook
DEMO_STORE_WEBHOOK_SECRET=
# Development only: allow http://localhost webhook endpoints (ignored when NODE_ENV=production)
# WEBHOOK_ALLOW_LOCALHOST=1

# ── scripts/e2e-testnet.ts (never in the web app) ──────────────────────────────────────────────────────
# E2E_BASE_URL=http://localhost:3000
# E2E_MERCHANT_KEY=0x…   (funded with a little testnet BTC for gas; registers as merchant + sends the refund)
# E2E_CUSTOMER_KEY=0x…   (testnet BTC for gas + ≥ 10 MUSD)
# E2E_WEBHOOK_PORT=4455
# E2E_WEBHOOK_PUBLIC_URL=https://<tunnel>/   (public https URL forwarding to the local receiver; else
#                                             WEBHOOK_ALLOW_LOCALHOST=1 on a local dev server)

# ── Contracts (contracts/.env only) ────────────────────────────────────────────────────────────────────
# DEPLOYER_PRIVATE_KEY=
