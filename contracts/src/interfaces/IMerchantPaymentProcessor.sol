pragma solidity 0.8.28;

/// @title IMerchantPaymentProcessor — FROZEN interface (MezoCommerce)
/// @notice Non-custodial one-time payments in MUSD on Mezo. A merchant registers an owner wallet, a payout address
///         and one or more intent signers. The backend creates a payment intent and an authorized signer signs it
///         (EIP-712). The customer submits the signed intent; the contract checks it and moves the exact amount
///         straight from the customer to the merchant's payout address with SafeERC20. The contract never holds funds.
///         Intent state is keyed by (merchantId, paymentId): each paymentId can be paid at most once per merchant
///         and can be cancelled by that merchant before it is paid. Another merchant using the same paymentId
///         never changes this merchant's state.
///         Refunds are sent by the merchant's owner or payout wallet straight to the original payer; the contract
///         caps the cumulative refund at the original amount.
interface IMerchantPaymentProcessor {
    /// @dev EIP-712 typed struct. Type string (must match exactly):
    /// "PaymentIntent(bytes32 paymentId,uint256 merchantId,address payout,address token,uint256 amount,address payer,uint64 expiresAt)"
    /// Domain: name "MezoCommerce", version "1", chainId, verifyingContract = this contract.
    struct PaymentIntent {
        bytes32 paymentId; // random 32 bytes generated by the backend; state is scoped to (merchantId, paymentId)
        uint256 merchantId; // on-chain merchant id
        address payout; // must equal the merchant's current payout address at pay time
        address token; // must be a supported token (MUSD)
        uint256 amount; // exact token units; must be > 0 and <= type(uint128).max
        address payer; // address(0) = anyone may pay; otherwise only this address
        uint64 expiresAt; // unix seconds; pay reverts when block.timestamp > expiresAt
    }

    struct Merchant {
        address owner; // wallet that registered; only it can change payout/signers/status
        address payout; // receives payments
        bool active; // inactive merchants cannot receive payments
    }

    /// @dev Stored for every completed payment; drives refunds.
    struct PaymentRecord {
        uint256 merchantId;
        address payer;
        address token;
        uint128 amount;
        uint128 refunded; // cumulative
        uint64 paidAt;
    }

    enum IntentState {
        None, // never paid or cancelled
        Paid,
        Cancelled
    }

    /// @dev Result of the read-only preflight `checkPayment`. Order is part of the interface.
    enum PayCheck {
        Ok,
        AlreadyPaid,
        Cancelled,
        Expired,
        UnsupportedToken,
        UnknownMerchant,
        MerchantInactive,
        PayoutMismatch,
        BadSignature,
        WrongPayer,
        InvalidAmount,
        Paused,
        InsufficientBalance,
        InsufficientAllowance
    }

    // ───────────── events ─────────────
    event MerchantRegistered(uint256 indexed merchantId, address indexed owner, address payout);
    event PayoutUpdated(uint256 indexed merchantId, address payout);
    event SignerUpdated(uint256 indexed merchantId, address indexed signer, bool allowed);
    event MerchantStatusUpdated(uint256 indexed merchantId, bool active);
    event TokenSupportUpdated(address indexed token, bool supported);

    /// @notice Emitted once per paid intent. `amount` equals the signed intent amount exactly.
    event PaymentCompleted(
        bytes32 indexed paymentId,
        uint256 indexed merchantId,
        address indexed payer,
        address payout,
        address token,
        uint256 amount,
        uint256 timestamp
    );
    event PaymentCancelled(bytes32 indexed paymentId, uint256 indexed merchantId, address by);
    /// @notice `from` is the merchant wallet the refund came from; `totalRefunded` is cumulative.
    event RefundCompleted(
        bytes32 indexed paymentId,
        uint256 indexed merchantId,
        address indexed payer,
        address from,
        uint256 amount,
        uint256 totalRefunded
    );

    // ───────────── errors ─────────────
    error ZeroAddress();
    error NotMerchantOwner();
    error NotAuthorized();
    error UnknownMerchant();
    error MerchantInactive();
    error PayoutMismatch();
    error UnsupportedToken();
    error InvalidAmount();
    error IntentExpired();
    error IntentAlreadyPaid();
    error IntentCancelled();
    error BadSignature();
    error WrongPayer();
    error NotPaid();
    error RefundExceedsPayment();

    // ───────────── merchant management (msg.sender = merchant owner) ─────────────
    /// @notice Registers msg.sender as owner of a new merchant. `initialSigner` may be address(0).
    function registerMerchant(address payout, address initialSigner) external returns (uint256 merchantId);
    function setPayout(uint256 merchantId, address payout) external;
    function setSigner(uint256 merchantId, address signer, bool allowed) external;
    function setMerchantActive(uint256 merchantId, bool active) external;

    // ───────────── payments ─────────────
    /// @notice Pays a signed intent. Requires a prior ERC-20 approval of at least `intent.amount` to this contract.
    function pay(PaymentIntent calldata intent, bytes calldata signature) external;

    /// @notice Same as `pay` but sets the allowance with EIP-2612 permit first (MUSD supports it).
    ///         The permit call is wrapped in try/catch; if it fails the existing allowance is used.
    function payWithPermit(
        PaymentIntent calldata intent,
        bytes calldata signature,
        uint256 permitDeadline,
        uint8 v,
        bytes32 r,
        bytes32 s
    ) external;

    /// @notice Merchant owner or an allowed signer of `merchantId` marks an unpaid paymentId as cancelled.
    function cancelPayment(uint256 merchantId, bytes32 paymentId) external;

    /// @notice Sends `amount` of the payment's token from msg.sender to the original payer of merchant `merchantId`'s
    ///         payment `paymentId`. msg.sender must be the merchant owner or current payout address. Needs approval
    ///         from msg.sender.
    function refund(uint256 merchantId, bytes32 paymentId, uint256 amount) external;

    // ───────────── admin (Ownable2Step) — cannot move funds or touch merchants ─────────────
    function setTokenSupported(address token, bool supported) external;
    function pause() external; // blocks pay / payWithPermit only; refunds and cancels stay open
    function unpause() external;

    // ───────────── views ─────────────
    function merchant(uint256 merchantId) external view returns (Merchant memory);
    function merchantCount() external view returns (uint256);
    function isSigner(uint256 merchantId, address signer) external view returns (bool);
    function isTokenSupported(address token) external view returns (bool);
    function intentState(uint256 merchantId, bytes32 paymentId) external view returns (IntentState);
    function payment(uint256 merchantId, bytes32 paymentId) external view returns (PaymentRecord memory);
    /// @notice EIP-712 digest of an intent (what the signer signs).
    function hashIntent(PaymentIntent calldata intent) external view returns (bytes32);
    /// @notice Read-only preflight for a given payer. Never reverts for a well-formed call.
    function checkPayment(PaymentIntent calldata intent, bytes calldata signature, address payerAddr)
        external
        view
        returns (PayCheck);
}
