# Copy to contracts/.env (gitignored; forge loads it automatically). Uncomment only what you use: an empty
# `VAR=` line is "set" for forge and fails to parse as an address/uint.

# Deployer: either a raw key here, or leave commented and use a forge keystore:
#   --account deployer --sender 0x017FF5FB886E90f9e5ADb405D8eFddffC1162dD2
# DEPLOYER_PRIVATE_KEY=0x...

# Optional: Ownable2Step admin (token allowlist + pause). Default: the deployer.
# OWNER_ADDRESS=0x...

# Optional, default Mezo testnet MUSD.
# MUSD_ADDRESS=0x118917a40FAF1CD7a13dB0Ef56C86De7973Ac503

# Local anvil only (chainid 31337): deploy a MockMUSD instead of using MUSD_ADDRESS.
# DEPLOY_MOCK_MUSD=true

# RegisterMerchant.s.sol (optional helper)
# MERCHANT_PRIVATE_KEY=0x...
# PROCESSOR_ADDRESS=0x...        (default: deployments/<chainId>.json)
# PAYOUT_ADDRESS=0x...           (default: the merchant wallet)
# INITIAL_SIGNER=0x...           (platform signer = address of the app's INTENT_SIGNER_PRIVATE_KEY)
